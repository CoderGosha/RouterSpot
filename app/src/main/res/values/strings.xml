    <string name="ob1_label">// 01 · What it is</string>
    <string name="ob1_title">VPN\nsharing</string>
    <string name="ob1_text">Your phone shares a regular Wi-Fi network, and all traffic of connected devices goes through your VPN. Nothing to set up on the laptop, TV or set-top box.</string>
