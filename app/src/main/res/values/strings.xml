    <string name="ob3_label">// 03 · No root needed</string>
    <string name="ob3_title">Pair\nonce</string>
    <string name="ob3_text">RouterSpot connects to the phone’s own wireless debugging and starts a service with shell rights. The pairing code is entered in a notification — without leaving settings.</string>
    <string name="ob3_reboot_label">&gt; After a restart</string>
    <string name="ob3_reboot_text">The service lives until the phone restarts. Then connect to any Wi-Fi and tap “Start service” — no need to pair again.</string>
    <string name="ob4_label">// 04 · Protection</string>
    <string name="ob4_title">No leaks</string>
    <string name="ob4_text">If the tunnel drops, clients stay offline but never go online directly. If the service stops, sharing turns off by itself. Clients get no IPv6.</string>
    <string name="ob4_how">How it works →</string>
    <string name="about_title_bar">How it works</string>
    <string name="about_label">// Diagram</string>
    <string name="about_title">Traffic\npath</string>
    <string name="about_clients_sub">laptop · TV · set-top box</string>
    <string name="about_link_wifi">Wi-Fi, no setup</string>
