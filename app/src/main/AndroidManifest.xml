<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Встроенный ADB: подключение к adbd этого телефона и поиск его портов через mDNS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Диагностика: исключение из оптимизации батареи одним нажатием (процесс со сторожем). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Выключение хотспота сторожем без служебного процесса; appop выдаёт служебный процесс. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- USB-служба получает права shell через инструментацию, см. ShellServer.runInApp. -->
    <instrumentation
        android:name="app.routerspot.server.UsbInstrumentation"
        android:targetPackage="app.routerspot" />

    <application
        android:name=".RouterSpotApp"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR-сканер ZXing: по умолчанию только альбомная ориентация. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <service
            android:name=".adb.PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pairing with wireless debugging via notification input" />
        </service>

        <service
            android:name=".RouterSpotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the leak guard alive while sharing a VPN-routed hotspot" />
        </service>

        <service
            android:name=".UsbGuardService"
            android:exported="false"
            android:process=":guard" />

        <!-- Отладочное управление без UI; отправить может только shell (DUMP). -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Служебный процесс (shell) передаёт сюда свой binder; uid проверяется в call(). -->
        <provider
            android:name=".ServerProvider"
            android:authorities="app.routerspot.server"
            android:exported="true" />
    </application>
</manifest>
